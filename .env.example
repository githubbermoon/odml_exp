EDGEPULSE_API_URL=http://127.0.0.1:8501
EDGEPULSE_CAMERA_INDEX=0
EDGEPULSE_MODEL=gemma-4-E2B-it-litert-lm
GEMMA4_E2B_MODEL_ID=gemma-4-e2b
EDGEPULSE_LITERT_SERVER_URL=http://127.0.0.1:9379

# Set this to a local LiteRT-LM runner command once Gemma 4 E2B is installed.
# The command must read the prompt from stdin and stream text/JSON to stdout.
EDGEPULSE_LITERT_CMD="./scripts/run_gemma4_e2b_litert.sh"

# Direct Gemma Vision receives JSON on stdin: {"prompt":"...","frame":{"data_url":"data:image/jpeg;base64,..."}}
EDGEPULSE_LITERT_VISION_CMD="./scripts/run_gemma4_e2b_vision.sh"
